{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "(TPL) PostgreSQL",
            "type": "shell",
            "command": [
                "cd tpl-backend/",
                "&&",
                "podman run -it --rm --name tpl_postgres",
                "-e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=tpl -p 5437:5432",
                "-v ./tpl/sql/:/docker-entrypoint-initdb.d/",
                "docker.io/library/postgres:18"
            ],
            "problemMatcher": []
        },
        {
            "label": "(TPL) backend",
            "type": "shell",
            "command": [
                "cd tpl-backend/",
                "&&",
                "until pg_isready -h localhost -p 5437; do echo 'Waiting for Postgres...'; sleep 1; done",
                "&&",
                "uv run uvicorn --reload --port=8037 tpl.main:app"
            ],
            "problemMatcher": [
                "$python"
            ],
            "options": {
                "env": {
					"DATABASE_URL": "postgresql://postgres:password@localhost:5437/tpl",
                    "POSTGRES_PORT": "5437",
                    "KEYCLOAK_URL": "http://localhost:8080",
                    "KEYCLOAK_URL_PUBLIC": "http://localhost:8080",
                    "KEYCLOAK_REALM": "master",
                    "KEYCLOAK_CLIENT_ID": "miz",
                    "KEYCLOAK_CLIENT_SECRET": "",
                    "PUBLIC_BASE_URL": "http://localhost:5137",
                    "EXTERNAL_SYSTEM": "tc",
                    "EXTERNAL_SYSTEM_URL": "http://localhost:8030",
                    "EXTERNAL_SYSTEM_UI_URL": "http://localhost:5130",
                    "EXTERNAL_FROZEN_STATUSES": "pending_review,published,archived",
                }
            }
        },
        {
            "label": "(TPL) frontend",
            "type": "shell",
            "command": [
                "cd tpl-frontend/",
                "&&",
                "until /bin/nc -z localhost 8037; do sleep 1; done",
                "&&",
                "pnpm run dev --port 5137 --open",
            ],
            "options": {
                "env": {
                    "VITE_API_PORT": "8037"
                }
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "🚀 TPL",
            "dependsOrder": "parallel",
            "dependsOn": [
                "(TPL) PostgreSQL",
                "(TPL) backend",
                "(TPL) frontend"
            ],
            "group": {
                "kind": "build",
            }
        },
        {
            "label": "(RSP) PostgreSQL",
            "type": "shell",
            "command": [
                "cd rsp-backend/",
                "&&",
                "podman run -it --rm --name rsp_postgres",
                "-e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=password -e POSTGRES_DB=rsp -p 5439:5432",
                "-v ./src/rsp_backend/sql/:/docker-entrypoint-initdb.d/",
                "docker.io/library/postgres:18"
            ],
            "problemMatcher": []
        },
        {
            "label": "(RSP) backend",
            "type": "shell",
            "command": [
                "cd rsp-backend/",
                "&&",
                "until pg_isready -h localhost -p 5439; do echo 'Waiting for Postgres...'; sleep 1; done",
                "&&",
                "uv run uvicorn --reload --port=8039 rsp_backend.main:app"
            ],
            "problemMatcher": [
                "$python"
            ],
            "options": {
                "env": {
                    "DATABASE_URL": "postgresql://postgres:password@localhost:5439/rsp"
                }
            }
        },
        {
            "label": "(RSP) frontend",
            "type": "shell",
            "command": [
                "cd rsp-frontend/",
                "&&",
                "until /bin/nc -z localhost 8039; do sleep 1; done",
                "&&",
                "pnpm run dev --port 5139 --open",
            ],
            "options": {
                "env": {
                    "VITE_API_PORT": "8039"
                }
            },
            "problemMatcher": [
                "$tsc"
            ]
        },
        {
            "label": "🚀 RSP",
            "dependsOrder": "parallel",
            "dependsOn": [
                "(RSP) PostgreSQL",
                "(RSP) backend",
                "(RSP) frontend"
            ],
            "group": {
                "kind": "build",
            }
        },
	]
}